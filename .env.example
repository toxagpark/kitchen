TIME_ZONE=UTC

HTTP_ADDR=:5050
HTTP_SHUTDOWN_TIMEOUT=30s
# CORS: разрешаем запросы к Kitchen из Swagger UI (localhost:8080)
HTTP_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

POSTGRES_HOST=kitchen_postgres
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin
POSTGRES_DB=kitchen
POSTGRES_TIMEOUT=10s

RESTAURANT_URL=http://restaurant-demo:8081
RESTAURANT_ORDER_PATH=/api/v1/orders

PROJECT_ROOT=.
LOGGER_LEVEL=DEBUG